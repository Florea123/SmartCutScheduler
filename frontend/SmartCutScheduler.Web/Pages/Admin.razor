@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IApiService ApiService
@inject IAdminService AdminService
@inject IBarberService BarberService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Admin Panel</PageTitle>

<div class="admin-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-10">

        @* ── Header ── *@
        <div class="admin-header mb-8">
            <div class="admin-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Style="font-size:2rem; color:#F5A623;" />
            </div>
            <div>
                <MudText Typo="Typo.h4" Style="font-weight:800; color:#f0f4f8; letter-spacing:-0.5px;">Panou Admin</MudText>
                <MudText Typo="Typo.body2" Style="color:#8fa3ba;">Gestionează frizerii și utilizatorii platformei</MudText>
            </div>
        </div>

        @* ── Tab navigation ── *@
        <div class="admin-tabs-wrap">
            <div class="admin-tab-btns">
                <button class="admin-tab-btn @(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="tab-icon" />
                    Adaugă Frizer
                </button>
                <button class="admin-tab-btn @(_activeTab == 1 ? "active" : "")" @onclick="() => _activeTab = 1">
                    <MudIcon Icon="@Icons.Material.Filled.People" Class="tab-icon" />
                    Utilizatori
                    @if (_users.Any())
                    {
                        <span class="tab-badge">@_users.Count</span>
                    }
                </button>
                <button class="admin-tab-btn @(_activeTab == 2 ? "active" : "")" @onclick="() => _activeTab = 2">
                    <MudIcon Icon="@Icons.Material.Filled.ContentCut" Class="tab-icon" />
                    Frizeri
                    @if (_barbers.Any())
                    {
                        <span class="tab-badge">@_barbers.Count</span>
                    }
                </button>
                <button class="admin-tab-btn @(_activeTab == 3 ? "active" : "")" @onclick="() => _activeTab = 3">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="tab-icon" />
                    Statistici
                </button>
            </div>

            @* ══ Tab 0: Adaugă Frizer ══ *@
            @if (_activeTab == 0)
            {
                <div class="admin-panel">
                    <MudText Typo="Typo.h6" Class="panel-title mb-5">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" Style="color:#F5A623; vertical-align:middle;" />
                        Adaugă Frizer Nou
                    </MudText>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">@_errorMessage</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(_successMessage))
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Outlined">@_successMessage</MudAlert>
                    }

                    <EditForm Model="@_barberModel" OnValidSubmit="HandleSubmitAsync">
                        <DataAnnotationsValidator />
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_barberModel.Name"
                                              Label="Nume complet"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              AdornmentIcon="@Icons.Material.Filled.Person"
                                              Adornment="Adornment.Start"
                                              AdornmentColor="Color.Warning" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_barberModel.Email"
                                              Label="Email"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              InputType="InputType.Email"
                                              AdornmentIcon="@Icons.Material.Filled.Email"
                                              Adornment="Adornment.Start"
                                              AdornmentColor="Color.Warning" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_barberModel.Password"
                                              Label="Parolă"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              InputType="InputType.Password"
                                              AdornmentIcon="@Icons.Material.Filled.Lock"
                                              Adornment="Adornment.Start"
                                              AdornmentColor="Color.Warning" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_barberModel.PhoneNumber"
                                              Label="Telefon"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              AdornmentIcon="@Icons.Material.Filled.Phone"
                                              Adornment="Adornment.Start"
                                              AdornmentColor="Color.Warning" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_barberModel.ConfirmPassword"
                                              Label="Confirmă parola"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              InputType="InputType.Password"
                                              AdornmentIcon="@Icons.Material.Outlined.Lock"
                                              Adornment="Adornment.Start"
                                              AdornmentColor="Color.Warning" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_barberModel.Description"
                                              Label="Descriere"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              Placeholder="Scurtă descriere despre frizer..." />
                            </MudItem>

                            @* Photo upload *@
                            <MudItem xs="12">
                                <div class="photo-upload-area">
                                    <div class="photo-preview">
                                        @if (!string.IsNullOrEmpty(_previewImageUrl))
                                        {
                                            <img src="@_previewImageUrl" alt="preview" class="photo-preview-img" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Style="font-size:2.5rem; color:#8fa3ba;" />
                                        }
                                    </div>
                                    <div class="photo-upload-info">
                                        <MudText Typo="Typo.body1" Style="color:#f0f4f8; font-weight:600;" Class="mb-1">
                                            Poză de profil <span style="color:#F5A623;">*</span>
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color:#8fa3ba;" Class="mb-3">
                                            JPG, JPEG sau PNG · Max 2MB
                                        </MudText>
                                        <label class="upload-btn">
                                            <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-1" Style="font-size:1rem;" />
                                            Alege fișier
                                            <InputFile OnChange="OnImageSelected" style="display:none;" />
                                        </label>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_imageError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" Variant="Variant.Outlined">@_imageError</MudAlert>
                                }
                            </MudItem>

                            <MudItem xs="12">
                                <MudButton ButtonType="ButtonType.Submit"
                                           Disabled="_submitting"
                                           FullWidth="true"
                                           Class="admin-submit-btn">
                                    @if (_submitting)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color:#0b1622;" />
                                        <span>Se adaugă...</span>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
                                        <span>Adaugă Frizer</span>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </div>
            }

            @* ══ Tab 1: Utilizatori ══ *@
            @if (_activeTab == 1)
            {
                <div class="admin-panel">
                    <div class="panel-title-row mb-5">
                        <MudText Typo="Typo.h6" Class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" Style="color:#F5A623; vertical-align:middle;" />
                            Toți Utilizatorii
                        </MudText>
                        <span class="panel-count">@_users.Count înregistrați</span>
                    </div>

                    @if (_loadingUsers)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="py-8">
                            <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
                        </MudStack>
                    }
                    else if (_users.Any())
                    {
                        <div class="admin-table-wrap">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Utilizator</th>
                                        <th>Email</th>
                                        <th>Telefon</th>
                                        <th>Rol</th>
                                        <th>Data Creării</th>
                                        <th>Acțiuni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in _users)
                                    {
                                        <tr>
                                            <td>
                                                <div class="table-user-cell">
                                                    <div class="table-avatar">@user.Name[0]</div>
                                                    <span>@user.Name</span>
                                                </div>
                                            </td>
                                            <td style="color:#8fa3ba;">@user.Email</td>
                                            <td style="color:#8fa3ba;">@(user.PhoneNumber ?? "—")</td>
                                            <td>
                                                <span class="role-badge role-@user.Role.ToLower()">@user.Role</span>
                                            </td>
                                            <td style="color:#8fa3ba;">@user.CreatedAtUtc.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <div class="table-actions">
                                                    <MudTooltip Text="Detalii">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                                       Size="Size.Small"
                                                                       Style="color:#8fa3ba;"
                                                                       OnClick="() => ShowUserDetails(user)" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="Șterge">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                       Size="Size.Small"
                                                                       Style="color:#ef5350;"
                                                                       OnClick="() => DeleteUser(user.Id)" />
                                                    </MudTooltip>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="admin-empty">
                            <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" Style="font-size:3rem; color:#2a4a6a;" />
                            <MudText Style="color:#8fa3ba;" Class="mt-2">Nu există utilizatori înregistrați.</MudText>
                        </div>
                    }
                </div>
            }

            @* ══ Tab 2: Frizeri ══ *@
            @if (_activeTab == 2)
            {
                <div class="admin-panel">
                    <div class="panel-title-row mb-5">
                        <MudText Typo="Typo.h6" Class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.ContentCut" Class="mr-2" Style="color:#F5A623; vertical-align:middle;" />
                            Toți Frizerii
                        </MudText>
                        <span class="panel-count">@_barbers.Count frizeri</span>
                    </div>

                    @if (_loadingBarbers)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="py-8">
                            <MudProgressCircular Color="Color.Warning" Indeterminate="true" />
                        </MudStack>
                    }
                    else if (_barbers.Any())
                    {
                        <div class="admin-barbers-grid">
                            @foreach (var barber in _barbers)
                            {
                                <div class="admin-barber-card">
                                    <div class="abc-left">
                                        @if (!string.IsNullOrEmpty(barber.PhotoUrl))
                                        {
                                            <img src="@barber.PhotoUrl" alt="@barber.Name" class="abc-avatar-img" />
                                        }
                                        else
                                        {
                                            <div class="abc-avatar-placeholder">@barber.Name[0]</div>
                                        }
                                        <span class="abc-status @(barber.IsActive ? "active" : "inactive")">
                                            @(barber.IsActive ? "Activ" : "Inactiv")
                                        </span>
                                    </div>
                                    <div class="abc-body">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#f0f4f8;">@barber.Name</MudText>
                                        <MudText Typo="Typo.caption" Style="color:#8fa3ba;">@barber.Email</MudText>
                                        <MudText Typo="Typo.caption" Style="color:#8fa3ba;">@barber.PhoneNumber</MudText>
                                        <div class="abc-services mt-2">
                                            @foreach (var svc in barber.Services.Take(3))
                                            {
                                                <span class="abc-svc-chip">@svc.Name</span>
                                            }
                                            @if (barber.Services.Count > 3)
                                            {
                                                <span class="abc-svc-chip abc-svc-more">+@(barber.Services.Count - 3)</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="abc-actions">
                                        <MudTooltip Text="Detalii">
                                            <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                           Size="Size.Small"
                                                           Style="color:#8fa3ba;"
                                                           OnClick="() => ShowBarberDetails(barber)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Șterge">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Style="color:#ef5350;"
                                                           OnClick="() => DeleteBarber(barber.Id)" />
                                        </MudTooltip>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="admin-empty">
                            <MudIcon Icon="@Icons.Material.Outlined.ContentCut" Style="font-size:3rem; color:#2a4a6a;" />
                            <MudText Style="color:#8fa3ba;" Class="mt-2">Nu există frizeri înregistrați.</MudText>
                        </div>
                    }
                </div>
            }
            @* ══ Tab 3: Statistici ══ *@
            @if (_activeTab == 3)
            {
                <div class="admin-panel">
                    <MudText Typo="Typo.h6" Class="panel-title mb-6">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" Style="color:#F5A623; vertical-align:middle;" />
                        Statistici Platformă
                    </MudText>

                    @* ── KPI Cards ── *@
                    <MudGrid Spacing="3" Class="mb-6">
                        <MudItem xs="6" sm="3">
                            <div class="kpi-card">
                                <div class="kpi-icon" style="background:rgba(245,166,35,0.12); border-color:rgba(245,166,35,0.3);">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Style="color:#F5A623;" />
                                </div>
                                <div class="kpi-value">@_users.Count</div>
                                <div class="kpi-label">Total utilizatori</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="kpi-card">
                                <div class="kpi-icon" style="background:rgba(76,175,80,0.12); border-color:rgba(76,175,80,0.3);">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Style="color:#66BB6A;" />
                                </div>
                                <div class="kpi-value" style="color:#66BB6A;">@_users.Count(u => u.Role == "Customer")</div>
                                <div class="kpi-label">Clienți</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="kpi-card">
                                <div class="kpi-icon" style="background:rgba(33,150,243,0.12); border-color:rgba(33,150,243,0.3);">
                                    <MudIcon Icon="@Icons.Material.Filled.ContentCut" Style="color:#42A5F5;" />
                                </div>
                                <div class="kpi-value" style="color:#42A5F5;">@_barbers.Count(b => b.IsActive)</div>
                                <div class="kpi-label">Frizeri activi</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="kpi-card">
                                <div class="kpi-icon" style="background:rgba(156,39,176,0.12); border-color:rgba(156,39,176,0.3);">
                                    <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Style="color:#AB47BC;" />
                                </div>
                                <div class="kpi-value" style="color:#AB47BC;">@_barbers.Sum(b => b.Services.Count)</div>
                                <div class="kpi-label">Servicii totale</div>
                            </div>
                        </MudItem>
                    </MudGrid>

                    @* ── Charts row ── *@
                    <MudGrid Spacing="3">
                        @* Pie: distribuție utilizatori pe roluri *@
                        <MudItem xs="12" md="5">
                            <div class="chart-card">
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#f0f4f8;" Class="mb-4">Distribuție utilizatori</MudText>
                                @if (_users.Any())
                                {
                                    <MudChart T="double" ChartType="ChartType.Pie"
                                              InputData="@_roleChartData"
                                              InputLabels="@_roleChartLabels"
                                              Width="100%" Height="380px"
                                              ChartOptions="@_pieOptions" />
                                    <div class="chart-legend mt-3">
                                        <span class="legend-dot" style="background:#F5A623;"></span><span class="legend-text">Clienți (@_users.Count(u => u.Role == "Customer"))</span>
                                        <span class="legend-dot" style="background:#42A5F5;"></span><span class="legend-text">Frizeri (@_users.Count(u => u.Role == "Barber"))</span>
                                        <span class="legend-dot" style="background:#EF5350;"></span><span class="legend-text">Admini (@_users.Count(u => u.Role == "Admin"))</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="chart-empty"><MudText Style="color:#8fa3ba;">Nu există date.</MudText></div>
                                }
                            </div>
                        </MudItem>

                        @* Bar: servicii per frizer *@
                        <MudItem xs="12" md="7">
                            <div class="chart-card">
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#f0f4f8;" Class="mb-4">Servicii per frizer</MudText>
                                @if (_barbers.Any())
                                {
                                    <MudChart T="double" ChartType="ChartType.Bar"
                                              ChartSeries="@_barberServicesSeries"
                                              XAxisLabels="@_barberNames"
                                              Width="100%" Height="380px"
                                              ChartOptions="@_barOptions" />
                                }
                                else
                                {
                                    <div class="chart-empty"><MudText Style="color:#8fa3ba;">Nu există date.</MudText></div>
                                }
                            </div>
                        </MudItem>

                        @* Bar: utilizatori înregistrați pe lună *@
                        <MudItem xs="12">
                            <div class="chart-card">
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#f0f4f8;" Class="mb-4">Înregistrări pe lună (ultimele 6 luni)</MudText>
                                @if (_users.Any())
                                {
                                    <MudChart T="double" ChartType="ChartType.Line"
                                              ChartSeries="@_registrationSeries"
                                              XAxisLabels="@_registrationLabels"
                                              Width="100%" Height="320px"
                                              ChartOptions="@_lineOptions" />
                                }
                                else
                                {
                                    <div class="chart-empty"><MudText Style="color:#8fa3ba;">Nu există date.</MudText></div>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </div>
            }

        </div>
    </MudContainer>
</div>

@* ── Dialog: detalii utilizator ── *@
<MudDialog @bind-IsVisible="_showUserDialog" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Style="color:#F5A623;" />
            <MudText Typo="Typo.h6" Style="color:#f0f4f8;">Detalii Utilizator</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_selectedUser != null)
        {
            <div class="detail-rows">
                <div class="detail-row"><span class="detail-label">ID</span><span class="detail-value" style="font-size:0.75rem;">@_selectedUser.Id</span></div>
                <div class="detail-row"><span class="detail-label">Nume</span><span class="detail-value">@_selectedUser.Name</span></div>
                <div class="detail-row"><span class="detail-label">Email</span><span class="detail-value">@_selectedUser.Email</span></div>
                <div class="detail-row"><span class="detail-label">Telefon</span><span class="detail-value">@(_selectedUser.PhoneNumber ?? "—")</span></div>
                <div class="detail-row"><span class="detail-label">Rol</span><span class="role-badge role-@_selectedUser.Role.ToLower()">@_selectedUser.Role</span></div>
                <div class="detail-row"><span class="detail-label">Creat la</span><span class="detail-value">@_selectedUser.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</span></div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <button class="dialog-close-btn" @onclick="() => _showUserDialog = false">Închide</button>
    </DialogActions>
</MudDialog>

@* ── Dialog: detalii frizer ── *@
<MudDialog @bind-IsVisible="_showBarberDialog" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ContentCut" Style="color:#F5A623;" />
            <MudText Typo="Typo.h6" Style="color:#f0f4f8;">Detalii Frizer</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_selectedBarber != null)
        {
            <div class="detail-rows">
                <div class="detail-row"><span class="detail-label">Nume</span><span class="detail-value">@_selectedBarber.Name</span></div>
                <div class="detail-row"><span class="detail-label">Email</span><span class="detail-value">@_selectedBarber.Email</span></div>
                <div class="detail-row"><span class="detail-label">Telefon</span><span class="detail-value">@_selectedBarber.PhoneNumber</span></div>
                <div class="detail-row"><span class="detail-label">Descriere</span><span class="detail-value">@_selectedBarber.Description</span></div>
            </div>
            <MudText Typo="Typo.subtitle2" Style="color:#F5A623; font-weight:700;" Class="mt-4 mb-2">Servicii Oferite</MudText>
            <div style="display:flex; flex-wrap:wrap; gap:6px;">
                @foreach (var service in _selectedBarber.Services)
                {
                    <span class="abc-svc-chip">@service.Name — @service.Price lei (@service.DurationMinutes min)</span>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <button class="dialog-close-btn" @onclick="() => _showBarberDialog = false">Închide</button>
    </DialogActions>
</MudDialog>

@code {
    private int _activeTab = 0;

    // Add Barber
    private CreateBarberRequest _barberModel = new();
    private bool _submitting = false;
    private string? _errorMessage;
    private string? _successMessage;
    private IBrowserFile? _selectedImage;
    private string? _previewImageUrl;
    private string? _imageError;

    // Users
    private List<UserDto> _users = new();
    private bool _loadingUsers = false;
    private UserDto? _selectedUser;
    private bool _showUserDialog = false;

    // Barbers
    private List<BarberDto> _barbers = new();
    private bool _loadingBarbers = false;
    private BarberDto? _selectedBarber;
    private bool _showBarberDialog = false;

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        await LoadBarbersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _loadingUsers = true;
        try
        {
            _users = await AdminService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare la încărcarea utilizatorilor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingUsers = false;
        }
    }

    private async Task LoadBarbersAsync()
    {
        _loadingBarbers = true;
        try
        {
            _barbers = await BarberService.GetAllBarbersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare la încărcarea frizerilor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingBarbers = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        _submitting = true;
        _errorMessage = null;
        _successMessage = null;

        // Validare parolele coincid
        if (_barberModel.Password != _barberModel.ConfirmPassword)
        {
            _errorMessage = "Parolele nu coincid!";
            _submitting = false;
            return;
        }

        // Validare poză obligatorie
        if (_selectedImage == null)
        {
            _imageError = "Poza de profil este obligatorie!";
            _submitting = false;
            return;
        }

        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(_barberModel.Name), "Name");
            content.Add(new StringContent(_barberModel.Email), "Email");
            content.Add(new StringContent(_barberModel.PhoneNumber), "PhoneNumber");
            content.Add(new StringContent(_barberModel.Password), "Password");
            content.Add(new StringContent(_barberModel.Description ?? string.Empty), "Description");
            var stream = _selectedImage.OpenReadStream(2 * 1024 * 1024);
            content.Add(new StreamContent(stream), "ProfileImage", _selectedImage.Name);

            var response = await ApiService.PostMultipartAsync("/api/barbers", content);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Frizer adăugat cu succes!";
                _barberModel = new();
                _selectedImage = null;
                _previewImageUrl = null;                await LoadBarbersAsync();
                Snackbar.Add("Frizer adăugat cu succes!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Eroare: {error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Eroare: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _imageError = null;
        if (file != null)
        {
            if (file.Size > 2 * 1024 * 1024)
            {
                _imageError = "Imaginea nu poate depăși 2MB.";
                _selectedImage = null;
                StateHasChanged();
                return;
            }
            var allowed = new[] { ".jpg", ".jpeg", ".png" };
            var ext = System.IO.Path.GetExtension(file.Name).ToLower();
            if (!allowed.Contains(ext))
            {
                _imageError = "Doar imagini .jpg, .jpeg, .png sunt permise.";
                _selectedImage = null;
                StateHasChanged();
                return;
            }
            _selectedImage = file;
            // Generează preview imagine
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var mime = file.ContentType;
            _previewImageUrl = $"data:{mime};base64,{base64}";
            StateHasChanged();
        }
    }

