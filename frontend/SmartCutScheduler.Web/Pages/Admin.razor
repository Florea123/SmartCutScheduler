    };

    private double[] GetRegistrationsPerMonth()
    {
        var now = DateTime.UtcNow;
        var result = new double[6];
        for (int i = 0; i < 6; i++)
        {
            var month = now.AddMonths(-(5 - i));
            result[i] = _users.Count(u =>
                u.CreatedAtUtc.Year == month.Year &&
                u.CreatedAtUtc.Month == month.Month);
        }
        return result;
    }

    private string[] GetLastSixMonthLabels()
    {
        var now = DateTime.UtcNow;
        var romanianMonths = new[]
        {
            "Ian", "Feb", "Mar", "Apr", "Mai", "Iun",
            "Iul", "Aug", "Sep", "Oct", "Nov", "Dec"
        };
        return Enumerable.Range(0, 6)
            .Select(i => romanianMonths[now.AddMonths(-(5 - i)).Month - 1])
            .ToArray();
    }

