@using SmartCutScheduler.Web.Models
@using MudBlazor
@inject ReviewService ReviewService
@inject ISnackbar Snackbar

<div style="padding: 16px 20px;">

@* ─── Summary bar ─── *@
@if (Reviews != null && Reviews.Any())
{
    <MudPaper Elevation="0" Class="pa-4 mb-4 rounded-lg"
              Style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 1px solid rgba(255,193,7,0.3);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Style="font-size:2.4rem; font-weight:800; color:#FFD700; line-height:1;">
                    @AverageRating.ToString("0.0")
                </MudText>
                <MudRating SelectedValue="@((int)Math.Round(AverageRating))" ReadOnly="true" MaxValue="5"
                           Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.caption" Style="color:#aaa;">@Reviews.Count review@(Reviews.Count == 1 ? "" : "-uri")</MudText>
            </MudStack>
            <MudStack Spacing="1" Style="min-width:160px;">
                @for (int star = 5; star >= 1; star--)
                {
                    var s = star;
                    var count = Reviews.Count(r => r.Rating == s);
                    var pct = Reviews.Count > 0 ? (double)count / Reviews.Count * 100 : 0;
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.caption" Style="color:#FFD700; min-width:8px;">@s</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color:#FFD700;" />
                        <MudProgressLinear Value="@pct" Color="Color.Warning" Rounded="true" Size="Size.Small"
                                           Style="flex:1; height:6px;" />
                        <MudText Typo="Typo.caption" Style="color:#aaa; min-width:20px;">@count</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
}

@* ─── Reviews list ─── *@
@if (Reviews == null)
{
    <MudStack AlignItems="AlignItems.Center" Class="py-4">
        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" />
    </MudStack>
}
else if (!Reviews.Any())
{
    <MudPaper Elevation="0" Class="pa-6 text-center rounded-lg mb-4"
              Style="background: rgba(255,255,255,0.04); border: 1px dashed rgba(255,255,255,0.15);">
        <MudIcon Icon="@Icons.Material.Outlined.RateReview" Style="color:#555; font-size:2.5rem;" />
        <MudText Typo="Typo.body2" Style="color:#777;" Class="mt-2">
            Fii primul care lasă un review!
        </MudText>
    </MudPaper>
}
else
{
    <div style="max-height:320px; overflow-y:auto; padding-right:4px;" class="review-scroll">
        @foreach (var review in Reviews)
        {
            var isOwn = review.UserId == CurrentUserId;
            <MudPaper Elevation="0" Class="mb-3 pa-3 rounded-lg"
                      Style="@($"background: {(isOwn ? "rgba(255,193,7,0.08)" : "rgba(255,255,255,0.05)")}; border: 1px solid {(isOwn ? "rgba(255,193,7,0.4)" : "rgba(255,255,255,0.1)")};")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Style="background:#FFD700; color:#000; width:32px; height:32px; font-size:0.85rem; font-weight:700;">
                            @(review.UserName.Length > 0 ? review.UserName[0].ToString().ToUpper() : "?")
                        </MudAvatar>
                        <MudStack Spacing="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.body2" Style="font-weight:600; color:#eee;">@review.UserName</MudText>
                                @if (isOwn)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                             Style="height:18px; font-size:0.65rem; padding:0 6px;">Tu</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption" Style="color:#666;">
                                @((review.UpdatedAt ?? review.CreatedAt).ToLocalTime().ToString("dd MMM yyyy"))
                                @if (review.UpdatedAt.HasValue)
                                {
                                    <span style="color:#555;"> · editat</span>
                                }
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudRating SelectedValue="@review.Rating" ReadOnly="true" MaxValue="5"
                               Size="Size.Small" Color="Color.Warning" />
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(review.Comment))
                {
                    <MudText Typo="Typo.body2" Class="mt-2" Style="color:#ccc; line-height:1.5;">
                        "@review.Comment"
                    </MudText>
                }
            </MudPaper>
        }
    </div>
}

@* ─── Submit form ─── *@
<MudDivider Class="my-3" Style="border-color:rgba(255,255,255,0.1);" />

@if (_authState?.User?.Identity?.IsAuthenticated == true)
{
    <MudText Typo="Typo.subtitle2" Style="color:#eee; font-weight:600;" Class="mb-3">
        @(HasExistingReview ? "Modifică review-ul tău" : "Lasă un review")
    </MudText>

    <MudStack Spacing="3">
        <MudStack Spacing="1">
            <MudText Typo="Typo.caption" Style="color:#aaa;">Rating</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudRating SelectedValue="@_ratingInput" SelectedValueChanged="OnRatingChanged"
                           MaxValue="5" Color="Color.Warning" Size="Size.Medium" />
                <MudText Typo="Typo.body2" Style="color:#FFD700; font-weight:600;">
                    @_ratingLabels[_ratingInput - 1]
                </MudText>
            </MudStack>
        </MudStack>

        <MudTextField @bind-Value="_commentInput"
                      Label="Comentariu (opțional)"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Placeholder="Spune-ne ce ți-a plăcut..."
                      Counter="500"
                      MaxLength="500"
                      Style="--mud-palette-text-primary:#eee;" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="SubmitReview"
                   Disabled="_submitting"
                   FullWidth="true"
                   Style="font-weight:700; letter-spacing:0.5px; color:#000;">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(HasExistingReview ? "ACTUALIZEAZĂ REVIEW-UL" : "PUBLICĂ REVIEW-UL")
        </MudButton>
    </MudStack>
}
else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"
              Style="border-color:rgba(255,255,255,0.2);">
        Trebuie să fii autentificat pentru a lăsa un review.
    </MudAlert>
}

</div>

@code {
    [Parameter] public Guid BarberId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<ReviewModel>? Reviews;
    private int _ratingInput = 5;
    private string? _commentInput;
    private bool _submitting;
    private AuthenticationState? _authState;
    private Guid CurrentUserId = Guid.Empty;

    private bool HasExistingReview =>
        CurrentUserId != Guid.Empty && Reviews?.Any(r => r.UserId == CurrentUserId) == true;

    private double AverageRating =>
        Reviews != null && Reviews.Any() ? Reviews.Average(r => r.Rating) : 0;

    private readonly string[] _ratingLabels = { "Dezamăgitor", "Slab", "Ok", "Bun", "Excelent" };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask != null)
            _authState = await AuthStateTask;

        CurrentUserId = await GetCurrentUserIdAsync();

        if (BarberId != Guid.Empty)
            await LoadReviews();
    }

    private async Task LoadReviews()
    {
        Reviews = await ReviewService.GetReviewsForBarberAsync(BarberId);

        if (CurrentUserId != Guid.Empty)
        {
            var myReview = Reviews.FirstOrDefault(r => r.UserId == CurrentUserId);
            if (myReview != null)
            {
                _ratingInput = Math.Clamp(myReview.Rating, 1, 5);
                _commentInput = myReview.Comment;
            }
            else
            {
                _ratingInput = 5;
                _commentInput = string.Empty;
            }
        }
    }

    private async Task SubmitReview()
    {
        _submitting = true;
        try
        {
            var success = await ReviewService.AddOrUpdateReviewAsync(BarberId, _ratingInput, _commentInput);
            if (success)
            {
                Snackbar.Add(HasExistingReview ? "Review actualizat!" : "Review publicat!", Severity.Success);
                await LoadReviews();
            }
            else
            {
                Snackbar.Add("A apărut o eroare. Încearcă din nou.", Severity.Error);
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private void OnRatingChanged(int value)
    {
        _ratingInput = value;
    }

    private async Task<Guid> GetCurrentUserIdAsync()
    {
        if (AuthStateTask == null) return Guid.Empty;
        var authState = await AuthStateTask;
        var sub = authState.User.FindFirst(c => c.Type == "sub")?.Value;
        return Guid.TryParse(sub, out var id) ? id : Guid.Empty;
    }
}

