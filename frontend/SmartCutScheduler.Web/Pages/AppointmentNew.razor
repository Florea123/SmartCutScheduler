@using MudBlazor
@page "/appointment/new"
@using SmartCutScheduler.Web.Models
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject IAppointmentService AppointmentService
@inject IBarberService BarberService
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http

<PageTitle>Finalizeaza programarea – SmartCut Scheduler</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-10">
    <MudStack Spacing="0" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight:800; color:#f0f4f8;">Finalizeaza programarea</MudText>
        <MudText Typo="Typo.body2" Style="color:#8fa3ba;">Verifica detaliile si alege serviciul dorit</MudText>
    </MudStack>

    @* ── Booking summary card ── *@
    <MudPaper Elevation="0" Class="pa-5 mb-5"
              Style="background:linear-gradient(135deg,#1a2e42,#0d1b2a); border:1px solid rgba(245,166,35,0.3); border-radius:16px;">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.ContentCut" Style="color:#F5A623;" />
                <div>
                    <MudText Typo="Typo.caption" Style="color:#8fa3ba; text-transform:uppercase; letter-spacing:1px; font-size:0.7rem;">Frizer</MudText>
                    <MudText Style="font-weight:700; color:#f0f4f8;">@BarberName</MudText>
                </div>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="color:#F5A623;" />
                <div>
                    <MudText Typo="Typo.caption" Style="color:#8fa3ba; text-transform:uppercase; letter-spacing:1px; font-size:0.7rem;">Data si ora</MudText>
                    <MudText Style="font-weight:700; color:#f0f4f8;">@(Date.HasValue ? Date.Value.ToString("dd MMM yyyy, HH:mm") : "-")</MudText>
                </div>
            </MudStack>
        </MudStack>
    </MudPaper>

    @* ── Service picker ── *@
    <MudPaper Elevation="0" Class="pa-5 mb-5"
              Style="background:#132236; border:1px solid #1e3a56; border-radius:16px;">
        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#f0f4f8; margin-bottom:16px;">Alege serviciul</MudText>
        <MudSelect T="Guid?" @bind-Value="SelectedServiceId" Label="Serviciu" Variant="Variant.Outlined" Required="true">
            @foreach (var service in Services)
            {
                <MudSelectItem T="Guid?" Value="service.Id">
                    @service.Name — @service.Price Lei (@service.DurationMinutes min)
                </MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="Note" Label="Note (optional)" Variant="Variant.Outlined" Class="mt-4"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Notes" />
    </MudPaper>

    @* ── Total + Pay ── *@
    <MudPaper Elevation="0" Class="pa-5"
              Style="background:#132236; border:1px solid #1e3a56; border-radius:16px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudText Style="color:#8fa3ba; font-weight:600;">Total de plata</MudText>
            <MudText Style="font-size:1.8rem; font-weight:800; color:#F5A623;">
                @SelectedServicePrice.ToString("0.00") Lei
            </MudText>
        </MudStack>
        <MudButton Disabled="@(!SelectedServiceId.HasValue)" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Size="Size.Large" OnClick="StartStripePayment"
                   Style="font-weight:700; color:#000; border-radius:50px; font-size:1rem;">
            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Class="mr-2" />
            Plateste cu cardul
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid? BarberId { get; set; }
    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public Guid? ServiceId { get; set; }

    private string BarberName = string.Empty;
    private List<ServiceDto> Services = new();
    private Guid? SelectedServiceId;
    private string Note = string.Empty;
    private decimal SelectedServicePrice => Services.FirstOrDefault(s => s.Id == SelectedServiceId)?.Price ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!BarberId.HasValue && query.TryGetValue("barberId", out var barberIdStr))
            BarberId = Guid.TryParse(barberIdStr, out var bid) ? bid : (Guid?)null;
        if (!Date.HasValue && query.TryGetValue("date", out var dateStr))
            Date = DateTime.TryParse(dateStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var d) ? d : (DateTime?)null;
        if (!ServiceId.HasValue && query.TryGetValue("serviceId", out var serviceIdStr))
            ServiceId = Guid.TryParse(serviceIdStr, out var sid) ? sid : (Guid?)null;

        if (BarberId.HasValue)
        {
            var barber = await BarberService.GetBarberByIdAsync(BarberId.Value);
            if (barber != null) { BarberName = barber.Name; Services = barber.Services; }
        }
        if (ServiceId.HasValue) SelectedServiceId = ServiceId;
    }

    private async Task StartStripePayment()
    {
        if (!SelectedServiceId.HasValue || !BarberId.HasValue || !Date.HasValue) return;
        var service = Services.FirstOrDefault(s => s.Id == SelectedServiceId);
        if (service == null) return;

        var req = new {
            BarberId = BarberId.Value, ServiceId = SelectedServiceId.Value, Date = Date.Value,
            ServiceName = service.Name, Amount = service.Price, Notes = Note,
            SuccessUrl = "http://localhost:5177/", CancelUrl = "http://localhost:5177/"
        };
        var response = await Http.PostAsJsonAsync("/api/payments/create-checkout-session", req);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<StripeSessionResponse>();
            if (result?.url != null) Navigation.NavigateTo(result.url, forceLoad: true);
        }
    }
}
