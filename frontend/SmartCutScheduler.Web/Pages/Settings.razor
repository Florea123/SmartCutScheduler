@page "/settings"
@using SmartCutScheduler.Web.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Setari profil – SmartCut Scheduler</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-10">
    <MudStack Spacing="2" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight:800; color:#f0f4f8;">Setari profil</MudText>
        <MudText Typo="Typo.body2" Style="color:#8fa3ba;">Actualizeaza informatiile tale personale</MudText>
    </MudStack>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudStack>
    }
    else if (_user != null)
    {
        <MudPaper Class="pa-6" Elevation="0" Style="background:#132236; border:1px solid #1e3a56; border-radius:20px;">

            @* ── Avatar section ── *@
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                <div style="position:relative; display:inline-block;">
                    @if (_previewImageUrl != null || !string.IsNullOrWhiteSpace(_user?.ProfilePictureUrl))
                    {
                        <MudAvatar Style="width:100px; height:100px; border:3px solid #F5A623; box-shadow:0 4px 20px rgba(245,166,35,0.3);">
                            <MudImage Src="@(_previewImageUrl ?? FixProfileImageUrl(_user?.ProfilePictureUrl) ?? "")"
                                      Alt="avatar" Style="width:100%;height:100%;object-fit:cover;" />
                        </MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Style="width:100px; height:100px; border:3px solid #F5A623; background:linear-gradient(135deg,#F5A623,#FF8C00); font-size:2.5rem; font-weight:800; color:#000; box-shadow:0 4px 20px rgba(245,166,35,0.3);">
                            @(_user?.Name?.Length > 0 ? _user.Name[0].ToString().ToUpper() : "?")
                        </MudAvatar>
                    }
                    <div style="position:absolute; bottom:0; right:0; background:#F5A623; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center;">
                        <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Style="font-size:0.9rem; color:#000;" />
                    </div>
                </div>
                <MudText Typo="Typo.body2" Style="color:#8fa3ba;">Schimba poza de profil</MudText>
                <InputFile OnChange="OnImageSelected" style="display:none;" id="avatarInput" accept=".jpg,.jpeg,.png" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           Style="border-color:#2a4a6a; color:#8fa3ba;"
                           OnClick="@(() => { })">
                    <label for="avatarInput" style="cursor:pointer; margin:0;">Alege fisier</label>
                </MudButton>
                @if (!string.IsNullOrEmpty(_imageError))
                {
                    <MudText Typo="Typo.caption" Style="color:#f44336;">@_imageError</MudText>
                }
            </MudStack>

            <MudDivider Style="border-color:#1e3a56; margin-bottom:24px;" />

            @* ── Form fields ── *@
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_user.Name" Label="Nume complet" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
                <MudTextField @bind-Value="_user.PhoneNumber" Label="Numar de telefon" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                @if (_isBarber)
                {
                    <MudTextField @bind-Value="_user.Description" Label="Descriere (vizibila clientilor)" Variant="Variant.Outlined"
                                  Lines="3" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description" />
                }
            </MudStack>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveChanges" FullWidth="true"
                       Class="mt-6" Size="Size.Large"
                       Style="font-weight:700; color:#000; border-radius:50px;">
                <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
                Salveaza modificarile
            </MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    private UserDto? _user;
    private bool _loading = true;
    private bool _isBarber = false;
    private IBrowserFile? _selectedImage;
    private string? _imageError;
    private string? _previewImageUrl;

    [Inject] private IApiService ApiService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthService.GetCurrentUserAsync();
        _isBarber = _user?.Role == "Barber";
        _loading = false;
    }

    private string? FixProfileImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        if (url.StartsWith("/profile-images/"))
            return "http://localhost:5000" + url;
        return url;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _imageError = null;
        if (file != null)
        {
            if (file.Size > 2 * 1024 * 1024) { _imageError = "Imaginea nu poate depasi 2MB."; return; }
            var allowed = new[] { ".jpg", ".jpeg", ".png" };
            var ext = System.IO.Path.GetExtension(file.Name).ToLower();
            if (!allowed.Contains(ext)) { _imageError = "Doar imagini .jpg, .jpeg, .png sunt permise."; return; }
            _selectedImage = file;
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _previewImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            StateHasChanged();
        }
    }

    private async Task SaveChanges()
    {
        if (_user == null) return;
        if (string.IsNullOrWhiteSpace(_user.Name)) { Snackbar.Add("Numele este obligatoriu.", Severity.Error); return; }
        if (!string.IsNullOrWhiteSpace(_user.PhoneNumber) && _user.PhoneNumber.Length < 8)
        { Snackbar.Add("Numarul de telefon trebuie sa aiba minim 8 cifre.", Severity.Error); return; }

        var content = new MultipartFormDataContent();
        content.Add(new StringContent(_user.Id.ToString()), "UserId");
        content.Add(new StringContent(_user.Name), "Name");
        content.Add(new StringContent(_user.PhoneNumber ?? string.Empty), "PhoneNumber");
        content.Add(new StringContent(_user.Description ?? string.Empty), "Description");
        if (_selectedImage != null)
        {
            var stream = _selectedImage.OpenReadStream(2 * 1024 * 1024);
            content.Add(new StreamContent(stream), "ProfileImage", _selectedImage.Name);
        }
        var response = await ApiService.PutMultipartAsync("/api/profile", content);
        if (response.IsSuccessStatusCode) Snackbar.Add("Modificarile au fost salvate!", Severity.Success);
        else Snackbar.Add("Eroare la salvare. Incearca din nou!", Severity.Error);
    }
}
