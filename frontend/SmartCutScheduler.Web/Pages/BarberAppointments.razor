@page "/barber-appointments"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Barber")]
@inject IAppointmentService AppointmentService
@inject NavigationManager Navigation

<PageTitle>Programarile la mine</PageTitle>

<div class="ba-root">
    <div class="ba-header">
        <h4 class="ba-title">Programarile la mine</h4>
    </div>

    <div class="ba-date-row">
        <button class="ba-btn-primary" @onclick="ToggleCalendar">
            <span>📅</span> Selecteaza ziua
        </button>
        <span class="ba-selected-date">
            Ziua selectata: <b>@_selectedDate.ToString("dddd, dd MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("ro-RO"))</b>
        </span>
    </div>

    @if (_showCalendar)
    {
        <div class="ba-calendar-wrapper">
            <MudDatePicker
                PickerVariant="PickerVariant.Static"
                Date="_selectedDate"
                DateChanged="@OnDatePicked"
                DateFormat="dd/MM/yyyy"
                Class="ba-datepicker"
                Label="Alege ziua" />
        </div>
    }

    @if (_loading)
    {
        <div class="ba-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_appointments.Any(a => IsSameDay(a.AppointmentDate, _selectedDate)))
    {
        <div class="ba-table-wrapper">
            <MudTable Items="@_appointmentsFiltered" Hover="true" Breakpoint="Breakpoint.Sm"
                      Style="background:transparent;"
                      HeaderClass="ba-table-header"
                      RowClass="ba-table-row">
                <HeaderContent>
                    <MudTh Style="color:#8fa3ba;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #1e3a56;">Client</MudTh>
                    <MudTh Style="color:#8fa3ba;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #1e3a56;">Serviciu</MudTh>
                    <MudTh Style="color:#8fa3ba;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #1e3a56;">Data</MudTh>
                    <MudTh Style="color:#8fa3ba;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #1e3a56;">Ora</MudTh>
                    <MudTh Style="color:#8fa3ba;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #1e3a56;">Status</MudTh>
                    <MudTh Style="color:#8fa3ba;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #1e3a56;">Note</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Client" Style="color:#f0f4f8;">@context.UserName</MudTd>
                    <MudTd DataLabel="Serviciu" Style="color:#f0f4f8;">@context.ServiceName</MudTd>
                    <MudTd DataLabel="Data" Style="color:#f0f4f8;">@DateTime.ParseExact(context.AppointmentDate, "yyyy-MM-dd", null).ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Ora" Style="color:#F5A623;font-weight:600;">@context.StartTime</MudTd>
                    <MudTd DataLabel="Status">
                        <span class="ba-status-chip ba-status-@context.Status.ToLower()">
                            @GetStatusLabel(context.Status)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Note" Style="color:#8fa3ba;font-size:0.85rem;">@context.Notes</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
    else
    {
        <div class="ba-empty">
            <div class="ba-empty-icon">📋</div>
            <p class="ba-empty-text">Nu exista programari in ziua selectata</p>
        </div>
    }
</div>

<style>
    .ba-root {
        max-width: 960px;
        margin: 2rem auto;
        padding: 0 1rem;
    }
    .ba-header {
        margin-bottom: 1.5rem;
    }
    .ba-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #f0f4f8;
        margin: 0;
    }
    .ba-date-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .ba-btn-primary {
        background: #F5A623;
        color: #0b1622;
        border: none;
        border-radius: 8px;
        padding: 0.55rem 1.2rem;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: background 0.2s;
    }
    .ba-btn-primary:hover { background: #e09412; }
    .ba-selected-date {
        color: #8fa3ba;
        font-size: 0.95rem;
    }
    .ba-selected-date b { color: #f0f4f8; }
    .ba-calendar-wrapper {
        background: #132236;
        border-radius: 12px;
        border: 1px solid #1e3a56;
        padding: 1rem;
        margin-bottom: 1.5rem;
        display: inline-block;
    }
    .ba-loading {
        display: flex;
        justify-content: center;
        padding: 3rem 0;
    }
    .ba-table-wrapper {
        background: #132236;
        border-radius: 12px;
        border: 1px solid #1e3a56;
        overflow: hidden;
        padding: 0.5rem;
    }
    .ba-status-chip {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }
    .ba-status-scheduled { background: rgba(33,150,243,0.15); color: #64b5f6; }
    .ba-status-confirmed { background: rgba(76,175,80,0.15); color: #81c784; }
    .ba-status-completed { background: rgba(158,158,158,0.15); color: #bdbdbd; }
    .ba-status-cancelled { background: rgba(244,67,54,0.15); color: #e57373; }
    .ba-empty {
        text-align: center;
        padding: 4rem 2rem;
        background: #132236;
        border-radius: 12px;
        border: 1px solid #1e3a56;
    }
    .ba-empty-icon { font-size: 3rem; margin-bottom: 1rem; }
    .ba-empty-text { color: #8fa3ba; font-size: 1rem; }
</style>

@code {
    private List<AppointmentDto> _appointments = new();
    private List<AppointmentDto> _appointmentsFiltered => _appointments
        .Where(a => IsSameDay(a.AppointmentDate, _selectedDate))
        .Where(a => a.Status != "Cancelled")
        .Where(a => !IsInPast(a.AppointmentDate, a.StartTime))
        .OrderBy(a => a.StartTime)
        .ToList();

    private bool IsInPast(string date, string time)
    {
        if (DateTime.TryParseExact(date + " " + time, "yyyy-MM-dd HH:mm", null, System.Globalization.DateTimeStyles.None, out var dt))
        {
            return dt < DateTime.Now;
        }
        return false;
    }
    private bool _loading = true;
    private DateTime _selectedDate = DateTime.Today;
    private bool _showCalendar = false;

    private void ToggleCalendar()
    {
        _showCalendar = !_showCalendar;
    }

    private async Task OnDatePicked(DateTime? date)
    {
        if (date.HasValue)
        {
            _selectedDate = date.Value;
            _showCalendar = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnDateChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            _selectedDate = date.Value;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointmentsAsync();
    }

    private async Task LoadAppointmentsAsync()
    {
        _loading = true;
        try
        {
            _appointments = await AppointmentService.GetBarberAppointmentsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsSameDay(string appointmentDate, DateTime selectedDate)
    {
        if (DateTime.TryParseExact(appointmentDate, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var date))
        {
            return date.Date == selectedDate.Date;
        }
        return false;
    }

    private string GetStatusLabel(string status) => status switch
    {
        "Scheduled" => "Programat",
        "Confirmed" => "Confirmat",
        "Completed" => "Finalizat",
        "Cancelled" => "Anulat",
        _ => status
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Scheduled" => Color.Info,
        "Confirmed" => Color.Success,
        "Completed" => Color.Default,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
