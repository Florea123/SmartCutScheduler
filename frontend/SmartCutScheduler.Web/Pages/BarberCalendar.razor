@page "/barber/{BarberId:guid}"
@using SmartCutScheduler.Web.Models
@using SmartCutScheduler.Web.Services
@inject IBarberService BarberService
@inject IAppointmentService AppointmentService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(_barber?.Name ?? "Barber") - Calendar</PageTitle>

<div class="bc-root">
    @if (_loading)
    {
        <div class="bc-loading"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else if (_barber == null)
    {
        <MudAlert Severity="Severity.Error">Frizerul nu a fost gasit</MudAlert>
    }
    else
    {
        <div class="bc-barber-header">
            <div>
                <h2 class="bc-barber-name">@_barber.Name</h2>
                <p class="bc-barber-desc">@_barber.Description</p>
            </div>
        </div>

        <div class="bc-calendar-card">
            <div class="bc-month-nav">
                <button class="bc-nav-btn" @onclick="PreviousMonth">&#8249;</button>
                <span class="bc-month-label">@_currentMonth.ToString("MMMM yyyy")</span>
                <button class="bc-nav-btn" @onclick="NextMonth">&#8250;</button>
            </div>

            <div class="bc-day-headers">
                @foreach (var day in new[] { "Lun", "Mar", "Mie", "Joi", "Vin", "Sam", "Dum" })
                {
                    <div class="bc-day-header">@day</div>
                }
            </div>

            <div class="bc-calendar-grid">
                @foreach (var day in _calendarDays)
                {
                    var isToday = day == DateTime.Today;
                    var isCurrentMonth = day.Month == _currentMonth.Month;
                    var isSelected = day.Date == _selectedDate?.Date;
                    var isWorkingDay = IsWorkingDay(day.DayOfWeek);
                    var isPast = day < DateTime.Today;
                    var isBeyondMaxDate = day > _maxDate;
                    var isDisabled = !isCurrentMonth || isPast || !isWorkingDay || isBeyondMaxDate;

                    var cellClass = "bc-day";
                    if (!isCurrentMonth) cellClass += " bc-day-other";
                    else if (isSelected) cellClass += " bc-day-selected";
                    else if (isToday) cellClass += " bc-day-today";
                    else if (isDisabled) cellClass += " bc-day-disabled";
                    else cellClass += " bc-day-available";

                    <button class="@cellClass" @onclick="() => SelectDay(day)" disabled="@isDisabled">
                        @day.Day
                    </button>
                }
            </div>
        </div>

        @if (_selectedDate.HasValue)
        {
            <div class="bc-slots-card">
                <h3 class="bc-slots-title">
                    Ore disponibile pentru <span class="bc-slots-date">@_selectedDate.Value.ToString("dd MMMM yyyy")</span>
                </h3>

                @if (_loadingSlots)
                {
                    <div class="bc-loading"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
                }
                else if (!_daySlots.Any())
                {
                    <div class="bc-no-slots">Nu sunt ore disponibile in aceasta zi</div>
                }
                else
                {
                    <div class="bc-slots-grid">
                        @foreach (var slot in _daySlots)
                        {
                            var slotTime = DateTime.Parse(slot.Time);
                            var isPast = _selectedDate.Value.Date == DateTime.Today && slotTime.TimeOfDay < DateTime.Now.TimeOfDay;
                            var isDisabled = slot.IsBooked || isPast;

                            <button class="bc-slot @(slot.IsBooked ? "bc-slot-booked" : isPast ? "bc-slot-past" : "bc-slot-free")"
                                    @onclick="@(() => SelectTimeSlot(slot))"
                                    disabled="@isDisabled">
                                @(slot.IsBooked ? "Ocupat" : slotTime.ToString("HH:mm"))
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<MudDialog @bind-IsVisible="_showServiceDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Selecteaza Serviciul</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Programare pentru ora: @_selectedSlot?.ToString("HH:mm")
        </MudText>
        <MudSelect T="Guid?" @bind-Value="_selectedServiceId" Label="Serviciu" Variant="Variant.Outlined" Required="true">
            @foreach (var service in _services)
            {
                <MudSelectItem T="Guid?" Value="service.Id">
                    @service.Name - @service.Price Lei (@service.DurationMinutes min)
                </MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelServiceSelection">Anuleaza</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAppointment" Disabled="@(!_selectedServiceId.HasValue)">
            Confirma
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .bc-root {
        max-width: 860px;
        margin: 2rem auto;
        padding: 0 1rem;
    }
    .bc-loading {
        display: flex;
        justify-content: center;
        padding: 3rem 0;
    }
    .bc-barber-header {
        background: #132236;
        border: 1px solid #1e3a56;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .bc-barber-name {
        font-size: 1.6rem;
        font-weight: 700;
        color: #f0f4f8;
        margin: 0 0 0.3rem;
    }
    .bc-barber-desc {
        color: #8fa3ba;
        margin: 0;
        font-size: 0.95rem;
    }
    .bc-calendar-card {
        background: #132236;
        border: 1px solid #1e3a56;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .bc-month-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.2rem;
    }
    .bc-nav-btn {
        background: #1e3a56;
        color: #f0f4f8;
        border: none;
        border-radius: 8px;
        width: 36px;
        height: 36px;
        font-size: 1.4rem;
        cursor: pointer;
        transition: background 0.2s;
        line-height: 1;
    }
    .bc-nav-btn:hover { background: #2a4a6a; }
    .bc-month-label {
        font-size: 1.1rem;
        font-weight: 700;
        color: #f0f4f8;
        text-transform: capitalize;
    }
    .bc-day-headers {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        margin-bottom: 4px;
    }
    .bc-day-header {
        text-align: center;
        padding: 6px 0;
        font-size: 0.75rem;
        font-weight: 700;
        color: #8fa3ba;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .bc-calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }
    .bc-day {
        border: none;
        border-radius: 8px;
        height: 52px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
    }
    .bc-day-other { background: transparent; color: #3a5a7a; cursor: default; }
    .bc-day-disabled { background: #0f1d2e; color: #3a5a7a; cursor: not-allowed; }
    .bc-day-available { background: #1e3a56; color: #f0f4f8; }
    .bc-day-available:hover { background: #2a4a6a; }
    .bc-day-today { background: #1e3a56; color: #F5A623; border: 2px solid #F5A623; }
    .bc-day-today:hover { background: #2a4a6a; }
    .bc-day-selected { background: #F5A623; color: #0b1622; }
    .bc-slots-card {
        background: #132236;
        border: 1px solid #1e3a56;
        border-radius: 12px;
        padding: 1.5rem;
    }
    .bc-slots-title {
        font-size: 1rem;
        font-weight: 600;
        color: #f0f4f8;
        margin: 0 0 1rem;
    }
    .bc-slots-date { color: #F5A623; }
    .bc-no-slots {
        color: #8fa3ba;
        text-align: center;
        padding: 2rem;
        background: #0f1d2e;
        border-radius: 8px;
    }
    .bc-slots-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
        gap: 8px;
    }
    .bc-slot {
        border: none;
        border-radius: 8px;
        padding: 10px 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
    }
    .bc-slot-free { background: rgba(76,175,80,0.15); color: #81c784; border: 1px solid rgba(76,175,80,0.3); }
    .bc-slot-free:hover { background: rgba(76,175,80,0.25); }
    .bc-slot-booked { background: rgba(244,67,54,0.1); color: #e57373; cursor: not-allowed; }
    .bc-slot-past { background: #0f1d2e; color: #3a5a7a; cursor: not-allowed; opacity: 0.6; }
</style>

@code {
    [Parameter]
    public Guid BarberId { get; set; }

    [SupplyParameterFromQuery(Name = "preDate")]
    public string? PreDate { get; set; }

    [SupplyParameterFromQuery(Name = "preTime")]
    public string? PreTime { get; set; }

    private BarberDto? _barber;
    private List<ServiceDto> _services = new();
    private List<TimeSlotDto> _daySlots = new();
    private List<DateTime> _calendarDays = new();

    private DateTime _currentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _maxDate = DateTime.Today.AddMonths(2);
    private DateTime? _selectedDate;
    private Guid? _selectedServiceId;
    private DateTime? _selectedSlot;
    private bool _showServiceDialog = false;

    private bool _loading = true;
    private bool _loadingSlots = false;
    private string _notes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBarberData();

        // Pre-select date from notification recommendation
        if (!string.IsNullOrWhiteSpace(PreDate) && DateTime.TryParse(PreDate, out var preDate)
            && preDate >= DateTime.Today && preDate <= _maxDate)
        {
            _currentMonth = new DateTime(preDate.Year, preDate.Month, 1);
            GenerateCalendarDays();
            await SelectDay(preDate);

            // Pre-highlight slot if preTime provided
            if (!string.IsNullOrWhiteSpace(PreTime) && _daySlots.Any())
            {
                var prefix = PreTime.Length >= 5 ? PreTime.Substring(0, 5) : PreTime;
                var match = _daySlots.FirstOrDefault(s =>
                    s.Time.StartsWith(prefix) && !s.IsBooked);
                if (match != null)
                    _selectedSlot = DateTime.Parse(_selectedDate!.Value.ToString("yyyy-MM-dd") + "T" + match.Time);
            }
        }
        else
        {
            GenerateCalendarDays();
        }
    }

    private async Task LoadBarberData()
    {
        _loading = true;
        _barber = await BarberService.GetBarberByIdAsync(BarberId);
        _services = await BarberService.GetServicesAsync();
        _loading = false;
    }

    private void GenerateCalendarDays()
    {
        _calendarDays.Clear();
        var firstDayOfMonth = _currentMonth;
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

        var startDate = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek + (int)DayOfWeek.Monday);
        if (startDate > firstDayOfMonth) startDate = startDate.AddDays(-7);

        var endDate = lastDayOfMonth.AddDays((int)DayOfWeek.Sunday - (int)lastDayOfMonth.DayOfWeek);
        if (endDate < lastDayOfMonth) endDate = endDate.AddDays(7);

        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            _calendarDays.Add(date);
        }
    }

    private bool IsWorkingDay(DayOfWeek dayOfWeek)
    {
        return dayOfWeek >= DayOfWeek.Monday && dayOfWeek <= DayOfWeek.Friday;
    }

    private void PreviousMonth()
    {
        var newMonth = _currentMonth.AddMonths(-1);
        if (newMonth >= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
        {
            _currentMonth = newMonth;
            GenerateCalendarDays();
        }
    }

    private void NextMonth()
    {
        var newMonth = _currentMonth.AddMonths(1);
        if (newMonth <= _maxDate)
        {
            _currentMonth = newMonth;
            GenerateCalendarDays();
        }
    }

    private async Task SelectDay(DateTime day)
    {
        if (day < DateTime.Today || day > _maxDate || !IsWorkingDay(day.DayOfWeek))
            return;

        _selectedDate = day;
        _daySlots.Clear();
        _selectedSlot = null;
        _selectedServiceId = null;

        await LoadDaySlotsAsync();
    }

    private async Task LoadDaySlotsAsync()
    {
        if (!_selectedDate.HasValue)
            return;

        _loadingSlots = true;
        _daySlots = await AppointmentService.GetDaySlotsAsync(BarberId, _selectedDate.Value);
        _loadingSlots = false;
    }

    private void SelectTimeSlot(TimeSlotDto slot)
    {
        if (slot.IsBooked)
            return;
        _ = CheckAuthAndNavigateToAppointment(slot);
    }

    private async Task CheckAuthAndNavigateToAppointment(TimeSlotDto slot)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var slotDate = _selectedDate?.Date ?? DateTime.Today;
        var slotTime = DateTime.Parse(slot.Time).TimeOfDay;
        var fullDate = slotDate.Add(slotTime);
        var appointmentUrl = $"appointment/new?barberId={BarberId}&date={Uri.EscapeDataString(fullDate.ToString("o"))}";
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(appointmentUrl)}");
            return;
        }
        Navigation.NavigateTo(appointmentUrl);
    }

    private void CancelServiceSelection()
    {
        _showServiceDialog = false;
        _selectedServiceId = null;
        _selectedSlot = null;
    }

    private async Task ConfirmAppointment()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo($"login?returnUrl=barber/{BarberId}");
            return;
        }

        if (!_selectedServiceId.HasValue || !_selectedSlot.HasValue)
            return;

        var dateParam = _selectedSlot.Value.ToString("o");
        Navigation.NavigateTo($"appointment/new?barberId={BarberId}&date={Uri.EscapeDataString(dateParam)}&serviceId={_selectedServiceId}");
        _showServiceDialog = false;
    }
}
