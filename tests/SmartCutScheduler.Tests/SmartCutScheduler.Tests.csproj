<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Coverlet MSBuild integration: run with /p:CollectCoverage=true /p:CoverletOutputFormat=opencover -->
    <CollectCoverage>false</CollectCoverage>
    <CoverletOutputFormat>opencover</CoverletOutputFormat>
    <CoverletOutput>coverage.opencover.xml</CoverletOutput>
    <Exclude>[*]*.Migrations.*,[*]*Program,[*]*DependencyInjection,[SmartCutScheduler.Tests]*</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\src\SmartCutScheduler.Application\SmartCutScheduler.Application.csproj" />
    <ProjectReference Include="..\..\backend\src\SmartCutScheduler.Domain\SmartCutScheduler.Domain.csproj" />
    <ProjectReference Include="..\..\backend\src\SmartCutScheduler.Infrastructure\SmartCutScheduler.Infrastructure.csproj" />
    <ProjectReference Include="..\..\backend\src\SmartCutScheduler.Api\SmartCutScheduler.Api.csproj" />
  </ItemGroup>

</Project>