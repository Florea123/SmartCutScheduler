# ── .NET Backend API ──────────────────────────────────────────────────────────
DOTNET_API_URL=http://api:5000
DOTNET_API_TIMEOUT=10

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
# Free tier: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here
DEFAULT_CITY=Bucharest

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/callback

# Token storage (file path inside container)
TOKEN_STORAGE_PATH=./data/calendar_tokens.json

# ── Scoring weights ───────────────────────────────────────────────────────────
WEIGHT_BARBER_RATING=25.0
WEIGHT_PREFERRED_TIME=30.0
WEIGHT_WEATHER=20.0
WEIGHT_CALENDAR=15.0
WEIGHT_URGENCY=10.0

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
